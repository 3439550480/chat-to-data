# ===== 本地环境变量模板（复制为同目录 .env 后填真实值；.env 已被 .gitignore 排除）=====
# 用途：AI 子服务（第 18/19 章）的模型配置 —— 仅使用 GLM 系列（OpenAI 兼容接口）

# GLM API Key（智谱开放平台获取）
GLM_API_KEY=

# GLM 模型名称（如 glm-4-flash / glm-4-plus / glm-4.6，按你订阅的型号填）
GLM_MODEL_NAME=

# GLM OpenAI 兼容接口 Base URL（智谱：https://open.bigmodel.cn/api/paas/v4）
GLM_BASE_URL=

# 可选：模型描述（模型列表展示用，留空则用默认文案）
GLM_MODEL_DESC=
