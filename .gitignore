# ===== 构建产物（make 一次就能回来的东西不进 git）=====
# 所有 build 目录（网关/用户子服务/data/proto/test 各处的 cmake 构建目录）
build/

# ===== 代码生成物（由工具链从源头再生）=====
# ODB 编译器生成：源码是 data/*Entity.h，产物可再生
app/data/odb/
app/data/sql/
# protoc 生成：源码是 proto/*.proto，产物可再生
app/proto/protoCode/

# ===== AI 工作区数据（个人工作记忆/临时抽取，非项目代码）=====
.workbuddy/

# ===== 本地环境变量（含 API Key，绝不入库；模板见 .env.example）=====
.env

# ===== 常规编译中间文件（防 build 外散落的中间产物）=====
*.o
*.d
*.tmp

# ===== 部署资产中的构建/运行产物（P4）=====
# collect.sh 收拢产物（7 二进制 + 网关 conf + www 副本，约 600MB；容器内 make 后可再生）
app/deploy/bin/
# 部署验证的抓取快照（curl 抓取的首页 HTML，一次性）
app/deploy/p4_host_index.html

# ===== 临时工作目录（课件 PDF 抽取、官方仓库 clone、编译/调试日志等）=====
app/tmp/

# ===== 日志与备份（通用规则：日志与 .bak 备份不进库）=====
*.log
*.bak

# ===== IDE 与系统杂项 =====
.vscode/
.idea/
Thumbs.db
.DS_Store
